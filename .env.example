# Mi'yar server-side configuration. Copy to .env.local (never commit real values).

# Model provider (only "openai" is supported).
MIYAR_LLM_PROVIDER=openai
MIYAR_LLM_MODEL=gpt-5.6
# Your OpenAI API key. Leave empty here; set it in .env.local or in Vercel project settings.
MIYAR_LLM_API_KEY=

# Secret for signing clarification state tokens (HMAC-SHA256). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MIYAR_STATE_SECRET=
